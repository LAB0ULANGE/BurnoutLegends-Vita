+// burnout patch: scenes begun, by target size, since the last vglGetSceneStats.
+#define VGL_SCENE_STAT_SLOTS 12
+static struct { int w, h; uint32_t scenes; } vgl_scene_stats[VGL_SCENE_STAT_SLOTS];
+static uint32_t vgl_scene_frames;
+static void vgl_count_scene(int w, int h) {
+	for (int i = 0; i < VGL_SCENE_STAT_SLOTS; i++) {
+		if (vgl_scene_stats[i].scenes == 0 && vgl_scene_stats[i].w == 0) {
+			vgl_scene_stats[i].w = w;
+			vgl_scene_stats[i].h = h;
+		}
+		if (vgl_scene_stats[i].w == w && vgl_scene_stats[i].h == h) {
+			vgl_scene_stats[i].scenes++;
+			return;
+		}
+	}
+}
+int vglGetSceneStats(char *buf, int size) {
+	int n = snprintf(buf, size, "%lu frames:", (unsigned long)vgl_scene_frames);
+	for (int i = 0; i < VGL_SCENE_STAT_SLOTS && n < size; i++) {
+		if (vgl_scene_stats[i].w == 0)
+			break;
+		n += snprintf(buf + n, size - n, " %dx%d %lu", vgl_scene_stats[i].w, vgl_scene_stats[i].h, (unsigned long)vgl_scene_stats[i].scenes);
+	}
+	vgl_memset(vgl_scene_stats, 0, sizeof(vgl_scene_stats));
+	vgl_scene_frames = 0;
+	return n;
+}
