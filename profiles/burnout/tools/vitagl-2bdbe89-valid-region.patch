+// burnout patch: scenes on the bound draw framebuffer only process the tiles
+// of its top-left w x h pixels (GL: lower-left, FBOs are flipped); 0 = all.
+void vglSetFramebufferValidRegion(GLsizei w, GLsizei h) {
+	if (!active_write_fb)
+		return;
+	active_write_fb->valid_w = w;
+	active_write_fb->valid_h = h;
+}
+
 void glBindRenderbuffer(GLenum target, GLuint rb) {
 	THREAD_SAFE()
 
